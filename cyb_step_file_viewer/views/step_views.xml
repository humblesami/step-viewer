<odoo>
      <data>
          <record model="ir.ui.view" id="stp_viewer_form">
              <field name="name">Stp File Form</field>
              <field name="model">step.files</field>
              <field name="arch" type="xml">
                  <form>
                      <group>
                          <field name="file_title" />
                          <field name="file_raw_name" invisible="1"/>
                          <field name="original_stp" filename="file_raw_name"/>
                          <button invisible="not conversion_pending" name="action_preview_step_files" type="object"
                                  string="Preview File" class="oe_highlight"/>
                      </group>
                  </form>
              </field>
          </record>

          <record model="ir.ui.view" id="stp_viewer_tree">
              <field name="name">Stp File List</field>
              <field name="model">step.files</field>
              <field name="arch" type="xml">
                  <list>
                      <field name="file_title"/>
                      <field name="file_raw_name"/>
                      <field name="original_stp"/>
                  </list>
              </field>
          </record>

          <record model="ir.actions.act_window" id="stp_viewer_action_window">
              <field name="name">Stp Viewer</field>
              <field name="type">ir.actions.act_window</field>
              <field name="res_model">step.files</field>
              <field name="view_mode">list,form</field>
          </record>

          <record id="action_step_files_preview" model="ir.actions.client">
              <field name="name">STP File Preview</field>
              <field name="tag">step_files_preview_tag</field>
          </record>

          <menuitem name="STP Viewer" id="stp_viewer_menu"/>
          <menuitem name="Viewer" id="menu_1" action="stp_viewer_action_window"
                    parent="stp_viewer_menu"/>
      </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="purchase_order_portal_content_inherit_step" inherit_id="purchase.purchase_order_portal_content">

        <!-- 1. Inject the 3D Model buttons under the product name in each line -->
        <xpath expr="//div[@id='introduction']" position="before">
        <style>
        .purchase_tbody #product_name {
            flex-direction: column;
        }
        </style>
        </xpath>
        <xpath expr="//td[@id='product_name']" position="inside">
            <!-- Access step_files via the product_template associated with the line -->
            <t t-set="step_files" t-value="line.product_id.product_tmpl_id.step_files"/>
            <t t-if="step_files">
                <div class="step_files_container mt-2 mb-2">
                    <small class="text-muted mb-1 d-block">Available 3D Models:</small>
                    <div class="d-flex flex-wrap gap-1">
                        <t t-foreach="step_files" t-as="step_file">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm step-file-trigger"
                                    t-att-data-order-line-id="line.id"
                                    t-att-data-attachment-id="step_file.id"
                                    t-att-data-filename="step_file.name">
                                <i class="fa fa-cube me-1"></i>
                                <span t-esc="step_file.name"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>
            
            <t t-if="line.finished_client_model">
                <div class="step_files_container mt-2 mb-2">
                    <small class="text-muted mb-1 d-block">Finished 3D Model:</small>
                    <div class="d-flex flex-wrap gap-1">
                        <button type="button"
                                class="btn btn-outline-success btn-sm step-file-trigger"
                                t-att-data-order-line-id="line.id"
                                t-att-data-attachment-id="line.finished_client_model.id"
                                t-att-data-filename="line.finished_client_model.name">
                            <i class="fa fa-cube me-1"></i>
                            <span t-esc="line.finished_client_model.name"/>
                        </button>
                    </div>
                </div>
            </t>


        </xpath>

        <!-- 2. Inject the Modal Container at the very bottom of the portal content -->
        <xpath expr="//div[@id='introduction']" position="before">
            <!-- We only want the modal in the DOM once. We check if any line has a step file -->
            <t t-set="has_any_models" t-value="any(line.product_id.product_tmpl_id.step_files for line in order.order_line)"/>
            <t t-if="has_any_models">
                <div id="step_viewer_iframe_container" class="modal-overlay">
                    <link rel="stylesheet" href="/cyb_product_step_viewer/static/css/product_page.css"/>
                    <div class="modal-container">
                        <iframe id="step_viewer_iframe" src="" style="width: 100%; height: 100%; border: none;"></iframe>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

    <template id="portal_my_home_menu_purchase" name="Portal layout : purchase menu entries" inherit_id="portal.portal_breadcrumbs" priority="25">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'purchase'" class="breadcrumb-item active">
                Purchase Orders
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_purchase" name="Show Purchase Orders" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Purchase Orders</t>
                <t t-set="url" t-value="'/my/purchase'"/>
                <t t-set="placeholder_count" t-value="'purchase_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_purchase_orders" name="My Purchase Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-if="not orders">
                <p class="alert alert-warning">There are currently no purchase orders for your account.</p>
            </t>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Purchase Order #</th>
                        <th class="text-end">Order Date</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="orders" t-as="order">
                        <td>
                            <a t-att-href="order.get_portal_url()">
                                <t t-out="order.name"/>
                            </a>
                        </td>
                        <td class="text-end">
                            <span t-field="order.date_order" t-options="{'widget': 'date'}"/>
                        </td>
                        <td class="text-end">
                            <span t-field="order.amount_total"/>
                        </td>
                        <td class="text-end">
                            <span t-field="order.state" class="badge rounded-pill bg-info"/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
</odoo>
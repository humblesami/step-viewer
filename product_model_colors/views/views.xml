<odoo>
  <data>
    <record id="view_part_search_tree" model="ir.ui.view">
        <field name="name">part.search.list</field>
        <field name="model">part.search</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="search_term" required="1"/>
                <field name="group_title" required="1"/>
            </list>
        </field>
    </record>

    <record id="action_part_search" model="ir.actions.act_window">
        <field name="name">Model Parts Search Terms</field>
        <field name="res_model">part.search</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_part_search_config"
              name="Model Parts Search Terms"
              parent="sale.menu_sale_config"
              action="action_part_search"
              sequence="100"/>

    <record id="view_glb_parts_wizard_form" model="ir.ui.view">
        <field name="name">glb.parts.wizard.form</field>
        <field name="model">glb.parts.wizard</field>
        <field name="arch" type="xml">
            <form string="GLB Parts">
                <field name="parts_list" widget="text" style="height: 300px; width: 100%; font-family: monospace;" readonly="1"/>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

  </data>
</odoo>

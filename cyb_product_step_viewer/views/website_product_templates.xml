<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_step_viewer_assets" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
        </xpath>
    </template>

    <template id="product_step_files_list" inherit_id="website_sale.product">
        <xpath expr="//div[@id='o_wsale_product_details_content']/form[1]" position="before">

            <t t-if="product.step_files">
                <div class="step_files_container mb-3">
                    <h6 class="text-muted mb-2">Available 3D Models:</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="product.step_files" t-as="step_file">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm step-file-trigger"
                                    t-att-data-attachment-id="step_file.id"
                                    t-att-data-product-id="product.id"
                                    t-att-data-filename="step_file.name">
                                <i class="fa fa-cube me-1"></i>
                                <span t-esc="step_file.name"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <t t-set="cart_lines" t-value="request.cart and request.cart.order_line.filtered(lambda l: l.product_id.id == product.id) or False"/>
            <t t-set="active_line" t-value="cart_lines and cart_lines[0] or False"/>
            <t t-set="finished_model" t-value="active_line and active_line.finished_client_model or False"/>
            <t t-if="finished_model">
                <div class="step_files_container mb-3">
                    <h6 class="text-muted mb-2">Finished Model:</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button"
                                class="btn btn-outline-success btn-sm step-file-trigger"
                                t-att-data-attachment-id="finished_model.id"
                                t-att-data-product-id="product.id"
                                t-att-data-filename="finished_model.name">
                            <i class="fa fa-pencil-square-o me-1"></i>
                            <span t-esc="finished_model.name"/>
                        </button>
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//t[@t-call='website.layout']" position="inside">
            <t t-if="product.step_files">
                <div id="step_viewer_iframe_container" class="modal-overlay">
                    <link rel="stylesheet" href="/cyb_product_step_viewer/static/css/product_page.css"/>
                    <div class="modal-container">
                        <iframe id="step_viewer_iframe" src="" style="width: 100%; height: 100%; border: none;"></iframe>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="sale_order_portal_content_inherit_step_viewer" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//td[@name='td_product_name']" position="inside">
            <t t-if="line.finished_client_model">
                <div class="mt-2">
                    <button type="button"
                            class="btn btn-primary btn-sm step-file-trigger"
                            t-att-data-attachment-id="line.finished_client_model.id"
                            t-att-data-product-id="line.product_id.id"
                            t-att-data-line-id="line.id"
                            t-att-data-access-token="sale_order.access_token"
                            t-att-data-filename="line.finished_client_model.name">
                        <i class="fa fa-cube me-1"></i>
                        Finish model
                    </button>
                    <button t-if="line.is_model_modified"
                            type="button"
                            class="btn btn-outline-warning btn-sm restore-model-trigger"
                            t-att-data-line-id="line.id"
                            t-att-data-access-token="sale_order.access_token">
                        <i class="fa fa-undo me-1"></i> Restore
                    </button>
                </div>
            </t>
        </xpath>
    </template>

    <template id="sale_order_portal_template_inherit_step_viewer" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='introduction']" position="inside">
            <div id="step_viewer_iframe_container" class="modal-overlay" style="display:none;">
                <link rel="stylesheet" href="/cyb_product_step_viewer/static/css/product_page.css"/>
                <div class="modal-container">
                    <iframe id="step_viewer_iframe" src="" style="width: 100%; height: 100%; border: none;"></iframe>
                </div>
            </div>
        </xpath>
    </template>
</odoo>

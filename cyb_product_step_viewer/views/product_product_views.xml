<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_client_model" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.model</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="after">
                <field name="product_step_file_id" column_invisible="True"/>
                <field name="model_customization_json" optional="show" string="Finished Model" widget="many2one_3d_viewer"/>
                <button name="action_restore_original_model" type="object" string="Restore" icon="fa-undo" invisible="not model_customization_json" title="Restore Original Model"/>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_inherit_step" model="ir.ui.view">
        <field name="name">product.product.form.inherit.step</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="3D Model" name="step_file">
                    <group>
                        <field name="step_file_id" invisible="1"/>
                        <field name="step_file_name" invisible="1"/>
                        <div class="o_horizontal_separator">3D Model File</div>
                        <div class="d-flex align-items-center gap-3">
                            <field name="step_file_content" widget="binary" filename="step_file_name" nolabel="1"/>
                            <field name="step_file_id" widget="many2one_3d_viewer" nolabel="1" invisible="not step_file_id"/>
<!--                            <field name="color_template_id" invisible="model_colors!=False"/>-->
<!--                            <field name="model_colors" invisible="not color_template_id"/>-->
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit_step" model="ir.ui.view">
        <field name="name">product.template.form.inherit.step</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="3D Model" name="step_file">
                    <group>
                        <field name="step_file_id" invisible="1"/>
                        <field name="step_file_name" invisible="1"/>
                        <div class="o_horizontal_separator">3D Model File</div>
                        <div class="d-flex align-items-center gap-3">
                            <field name="step_file_content" widget="binary" filename="step_file_name" nolabel="1"/>
                            <field name="step_file_id" widget="many2one_3d_viewer" nolabel="1" invisible="not step_file_id"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

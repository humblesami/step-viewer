<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_glb_part_list" model="ir.ui.view">
        <field name="name">glb.part.list</field>
        <field name="model">glb.part</field>
        <field name="arch" type="xml">
            <list string="Glb Parts">
                <field name="part_number"/>
                <field name="part_name"/>
            </list>
        </field>
    </record>
    <record id="view_order_form_inherit_client_model" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.model</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="after">
                <field name="product_step_file_id" column_invisible="True"/>
                <field name="model_customization_json" optional="show" string="Finished Model" widget="many2one_3d_viewer"/>
                <button name="action_restore_original_model" type="object" string="Restore" icon="fa-undo" invisible="not model_customization_json" title="Restore Original Model"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit_step" model="ir.ui.view">
        <field name="name">product.template.form.inherit.step</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="before">
                <page string="3D Model" name="step_file">
                    <group>
                        <field name="step_file_id" invisible="1"/>
                        <field name="step_file_name" invisible="1"/>
                        <div class="o_horizontal_separator">3D Model File</div>
                        <div class="d-flex align-items-center gap-3">
                            <field name="step_file_content" widget="binary" filename="step_file_name" nolabel="1"/>
                            <field name="step_file_id" widget="many2one_3d_viewer" nolabel="1" invisible="not step_file_id"/>                            
                        </div>

                    </group>

                    <h3>Glb Parts</h3>
                    <field name="model_part_ids">
                        <list rownumbers="1">
                            <field name="part_number"/>
                            <field name="part_name"/>
                        </list>
                    </field>

                    <div class="glb_groups">
                        <h3 class="o_horizontal_separator mt-4">Part Groups &amp; Customization</h3>

                        <field name="parts_group_ids" nolabel="1">
                            <list>
                                <field name="group_title" string="Group Name"/>
                                <field name="color_template_id"/>
                                <field name="part_count"/>
                            </list>
                            <form string="Part Group Configuration">
                                <group>
                                    <field name="group_title" string="Group Name" required="1"/>
                                    <field name="color_template_id" string="Allowed Colors Template"/>
                                    <field name="part_count" string="Count" readonly="1"/>
                                </group>
                                <field name="part_ids" nolabel="1" widget="many2many" domain="[('att_id', '=', parent.step_file_id)]">
                                    <list>
                                        <field name="part_number"/>
                                        <field name="part_name" string="Part Name"/>
                                    </list>
                                </field>
                            </form>
                        </field>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

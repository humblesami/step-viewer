<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_client_model" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.model</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="after">
                <field name="product_step_file_id" column_invisible="True"/>
                <field name="model_customization_json" optional="show" string="Finished Model" widget="many2one_3d_viewer"/>
                <button name="action_restore_original_model" type="object" string="Restore" icon="fa-undo" invisible="not model_customization_json" title="Restore Original Model"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit_step" model="ir.ui.view">
        <field name="name">product.template.form.inherit.step</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="3D Model" name="step_file">
                    <group>
                        <field name="step_file_id" invisible="1"/>
                        <field name="step_file_name" invisible="1"/>
                        <field name="has_glb_parts" invisible="1"/>
                        <div class="o_horizontal_separator">3D Model File</div>
                        <div class="d-flex align-items-center gap-3">
                            <field name="step_file_content" widget="binary" filename="step_file_name" nolabel="1"/>
                            <field name="step_file_id" widget="many2one_3d_viewer" nolabel="1" invisible="not step_file_id"/>
                            <button name="action_generate_part_names_json" type="object" string="Generate Part Names" invisible="not step_file_id or has_glb_parts" class="btn-primary"/>
                            <button name="action_view_glb_parts" type="object" string="👁️ View GLB Parts" invisible="not has_glb_parts" class="btn-info"/>
                        </div>

                        <div invisible="not has_glb_parts">
                            <div class="o_horizontal_separator mt-4">Part Groups &amp; Customization</div>
                            <button name="action_auto_generate_parts_groups" type="object" string="⚡ Auto-Generate Groups" class="btn-secondary mb-2"/>
                            
                            <field name="parts_groups" nolabel="1">
                                <list>
                                    <field name="display_name" string="Group Name"/>
                                    <field name="color_template_id"/>
                                    <field name="part_count"/>
                                </list>
                                <form string="Part Group Configuration">
                                    <group>
                                        <group>
                                            <field name="display_name" string="Group Name" required="1"/>
                                            <field name="color_template_id" string="Allowed Colors Template"/>
                                        </group>
                                        <group>
                                            <field name="part_count" string="Number of 3D Parts" readonly="1"/>
                                            <field name="chosen_color" string="Current Color" readonly="1"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="Search Term" name="search_term">
                                            <field name="part_search_id" widget="many2many_tags"/>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

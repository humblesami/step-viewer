<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_client_model" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.model</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="after">
                <field name="finished_client_model" optional="show" string="Finished Model" widget="many2one_3d_viewer"/>
                <field name="is_model_modified" column_invisible="True"/>
                <button name="action_restore_original_model" type="object" string="Restore" icon="fa-undo" invisible="not is_model_modified" title="Restore Original Model"/>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_inherit_step" model="ir.ui.view">
        <field name="name">product.product.form.inherit.step</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="3D Models" name="step_files">
                    <group>
                        <field name="step_files" widget="many2many_binary" string="STEP Files"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit_step" model="ir.ui.view">
        <field name="name">product.template.form.inherit.step</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="3D Models" name="step_files">
                    <group>
                        <field name="step_files" widget="many2many_binary" string="STEP Files"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
